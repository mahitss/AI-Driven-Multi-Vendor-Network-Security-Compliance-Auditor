# ==============================================================================
# NETVIGIL — AUTONOMOUS NETWORK SECURITY ENGINEER
# Environment Variables & Configuration Reference
# ==============================================================================

# Core Application Environment (production / development / staging)
ENVIRONMENT=production

# Cryptographic Secret Key (Required for session signature validation, min 32 characters in production)
SECRET_KEY=production-secret-key-netvigil-ntro-sih26155-enterprise-hardened

# Server Port (Google Cloud Run injects PORT=8080 automatically)
PORT=8000

# Database Connection (Supports PostgreSQL / Cloud SQL or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./data/netvigil.db
SYNC_DATABASE_URL=sqlite:///./data/netvigil.db

# ==============================================================================
# GOOGLE CLOUD & GEMINI CONFIGURATION
# ==============================================================================

# Google Cloud Project ID (Required for Cloud Run & Firestore)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# Google Gemini API Key (Optional when running on GCP with Application Default Credentials)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Selection (Official Hackathon Requirement: Gemini 3.5+)
AI_MODEL=gemini-3.5
AI_PROVIDER=gemini

# ==============================================================================
# SECURITY & CORS POLICIES
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]
