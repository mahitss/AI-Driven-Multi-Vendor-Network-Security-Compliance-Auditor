# ==============================================================================
# NETVIGIL — AUTONOMOUS NETWORK SECURITY COMPLIANCE AUDITOR
# Canonical Environment Variables & Configuration Reference
# ==============================================================================

# Core Application Environment (production / development / staging)
ENVIRONMENT=production
DEBUG=False

# Cryptographic Secret Key (Required: min 32 characters in production)
SECRET_KEY=your-production-secret-key-minimum-32-characters-here

# Server Port (Google Cloud Run injects PORT=8080 automatically)
PORT=8000

# Database Connection (PostgreSQL for production / SQLite for local)
DATABASE_URL=sqlite+aiosqlite:///./data/netvigil.db
SYNC_DATABASE_URL=sqlite:///./data/netvigil.db

# ==============================================================================
# AI PROVIDER & GEMINI 3.5 CONTROL PLANE
# Canonical Production Setting: OpenRouter Gateway with Google Gemini 3.5
# ==============================================================================
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-3.5
AI_TEMPERATURE=0.0
AI_TIMEOUT_SECONDS=30

# Optional Direct Gemini API / GCP Application Default Credentials (ADC)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# ==============================================================================
# AUTHENTICATION & SUPABASE JWT GATEWAY
# ==============================================================================
AUTH_ENABLED=True
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# ==============================================================================
# SECURITY, CORS & HOST POLICIES
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","https://your-production-domain.com"]
ALLOWED_HOSTS=["api.netvigil.com","your-cloudrun-url.a.run.app","localhost","127.0.0.1"]
