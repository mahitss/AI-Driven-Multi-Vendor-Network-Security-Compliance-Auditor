# ==============================================================================
# NetVigil Environment Configuration Template
# Problem Statement: SIH26155 (NTRO)
# NEVER commit real credentials or secret keys to source control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME=NetVigil
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16)
# Default for Docker Compose: postgresql+asyncpg://postgres:postgres@localhost:5432/netvigil
# SQLite fallback supported for rapid test runner: sqlite+aiosqlite:///./netvigil.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/netvigil
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netvigil

# Redis (Optional / Async Cache)
REDIS_URL=redis://localhost:6379/0

# Storage & Ingestion Security
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.cfg,.conf,.txt,.log

# AI Provider Configuration (OpenRouter Multi-Model Gateway)
# Server-side only: NEVER expose to the browser
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://netvigil.ntro.gov.in
OPENROUTER_SITE_NAME=NetVigil-Auditor

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Supabase Auth Configuration (Google OAuth & Identity Provider)
# Public Client Variables (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend Supabase Auth Verification (Server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
AUTH_ENABLED=true
