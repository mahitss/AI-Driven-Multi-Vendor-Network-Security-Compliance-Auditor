[
  {
    "id": "RULE-SSH-001",
    "normalized_control_id": "NETSEC-REMOTE-SSH-V2",
    "title": "Enforce SSH Protocol Version 2",
    "description": "Network devices must only allow SSH Version 2 connections. SSH Version 1 is cryptographically broken and vulnerable to MITM attacks.",
    "category": "Remote Access",
    "severity": "HIGH",
    "fact_path": "remote_access.ssh_version.value",
    "operator": "equals",
    "expected_value": 2,
    "explanation": "SSH version 1 utilizes vulnerable CRC-32 compensation attack mitigation and weak key exchange mechanisms. SSHv2 provides robust integrity and PFS.",
    "remediation_key": "enable_ssh_v2",
    "framework_mappings": {
      "CIS": {
        "control_id": "CIS-1.2.1",
        "title": "Ensure SSH Version 2 is enabled",
        "document": "CIS Cisco IOS 17 Benchmark",
        "version": "v2.0.0",
        "reference": "Section 1.2.1",
        "verified": true
      },
      "NIST": {
        "control_id": "NIST-AC-17",
        "title": "Remote Access - Secure Management Protocols",
        "document": "NIST SP 800-53 Rev 5",
        "version": "Rev 5",
        "reference": "AC-17(2)",
        "verified": true
      },
      "STIG": {
        "control_id": "STIG-NET0400",
        "title": "Network Device SSHv2 Enforcement",
        "document": "DoD Network Infrastructure STIG",
        "version": "v10r3",
        "reference": "NET0400-SSH",
        "verified": true
      },
      "ISO": {
        "control_id": "ISO-A.9.4.2",
        "title": "Secure Log-on Procedures",
        "document": "ISO/IEC 27001:2022",
        "version": "2022",
        "reference": "Control A.9.4.2",
        "verified": true
      }
    }
  },
